{
  "name": "@hogaria/shared",
  "private": true,
  "version": "0.0.0",
  "description": "Esquemas zod, constantes, errores, eventos en tiempo real y utilidades puras compartidas por web y API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "date-fns": "4.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hogaria/config": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
