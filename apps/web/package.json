{
  "name": "@hogaria/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PWA de Hogaria (Vite + React)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
