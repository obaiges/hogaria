# Copia este archivo a .env (nunca subas .env a git).
# Variables documentadas en docs/06-despliegue.md

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
COOKIE_DOMAIN=

# Postgres local (docker compose up -d db). En producción: Neon pooled / direct.
DATABASE_URL=postgresql://hogaria:hogaria@localhost:5432/hogaria
DIRECT_URL=postgresql://hogaria:hogaria@localhost:5432/hogaria

# Auth (HOG-050 / HOG-051)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SIGNUP_REQUIRES_INVITE=true

# Email (HOG-054)
RESEND_API_KEY=
EMAIL_FROM="Hogaria <no-reply@hogaria.obaiges.com>"

# IA (HOG-650)
GEMINI_API_KEY=
GEMINI_MODEL=
AI_LIMIT_FRIDGE_DETECT=10
AI_LIMIT_FRIDGE_RECIPES=15
AI_LIMIT_CHAT=60
AI_LIMIT_RECEIPT=20

# Push (HOG-600)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@obaiges.com

LOG_LEVEL=debug
