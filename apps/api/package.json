{
  "name": "@hogaria/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API de Hogaria (NestJS + Prisma)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "e2e:server": "node scripts/e2e-server.ts"
  },
  "dependencies": {
    "@hogaria/shared": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-socket.io": "12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.25",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hogaria/config": "workspace:*",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
