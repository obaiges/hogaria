{
  "extends": "@hogaria/config/tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "resolvePackageJsonExports": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "test",
    "prisma",
    "prisma.config.ts",
    "vitest.config.ts"
  ]
}
