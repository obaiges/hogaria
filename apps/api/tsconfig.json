{
  "extends": "@hogaria/config/tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "resolvePackageJsonExports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "test", "prisma.config.ts", "vitest.config.ts"]
}
